{
  "expo": {
    "name": "Dayly",
    "slug": "dayly-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4f46e5"
    },
    "plugins": [
      "expo-router"
    ],
    "schemes": [
      "dayly"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4f46e5"
      },
      "package": "com.dayly.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.dayly.app",
      "buildNumber": "1.0.0",
      "requiredDeviceCapabilities": [
        "armv7"
      ],
      "userInterfaceStyle": "light",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Dayly ha bisogno di accesso al calendario per sincronizzare i tuoi appuntamenti",
        "NSRemindersUsageDescription": "Dayly ha bisogno di accesso ai reminder per le notifiche"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/YOUR_PROJECT_ID"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "privacy": "public"
  }
}
